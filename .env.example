# NexusTrack Environment Configuration Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/trackpulse?retryWrites=true&w=majority

# NextAuth Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here_run_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3002

# Email Provider Mode ('both', 'gmail', or 'outlook')
EMAIL_PROVIDER=both

# Google / Gmail Configuration (Requires 16-character Google App Password)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=your_16_char_google_app_password

# Microsoft 365 / Outlook Configuration
OUTLOOK_USER=your_corporate_email@nybinfotech.com
OUTLOOK_PASS=your_outlook_or_app_password_if_applicable

# IMAP & SMTP Server Settings
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# AI Audit & Evaluation (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Excel & SharePoint Integration
EXCEL_PASSWORD=your_excel_protection_password
TL_EMAIL=team_lead@nybinfotech.com
SHAREPOINT_EXCEL_URL=https://yourcompany.sharepoint.com/:x:/r/personal/path/to/report.xlsx
